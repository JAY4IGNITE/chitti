<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No system action bar: the app draws its own header. Dark window background avoids a
         white flash before Compose attaches; bars match the surface colours. -->
    <style name="Theme.Chitti" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0E17</item>
        <item name="android:statusBarColor">#0A0E17</item>
        <item name="android:navigationBarColor">#131A29</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
